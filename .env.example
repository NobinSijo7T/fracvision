# FracVision — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://fracvision:changeme@localhost:5432/fracvision

# --- Dataset roots (override config.yaml paths) ---
# FRACATLAS_ROOT=model/datasets/FracAtlas
# GRAZPEDWRI_ROOT=model/datasets/GRAZPEDWRI-DX

# --- Model checkpoints (override config.yaml) ---
# MEDSAM_CHECKPOINT=/path/to/medsam.pth
# MAMBA_CHECKPOINT=model/checkpoints/mamba_longitudinal_best.pth

# --- MLflow ---
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=fracvision

# --- Backend ---
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# SECRET_KEY=change-this-secret-key

# --- Frontend ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
